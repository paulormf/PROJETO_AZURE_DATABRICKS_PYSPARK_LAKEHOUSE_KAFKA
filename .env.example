# Databricks Connection Configuration
# Copie este arquivo para .env e preencha com suas credenciais reais

# Databricks Workspace URL (ex: https://xxx.cloud.databricks.com)
DATABRICKS_HOST=

# Databricks Personal Access Token (PAT)
# Gerado em: https://<workspace-url>/settings/personal-access-tokens
DATABRICKS_TOKEN=

# Databricks Cluster ID (obrigatório para databricks-connect)
# Encontrado na URL do cluster: /#setting/clusters/<cluster_id>/configuration
# NOTA: Versão free do Databricks não tem clusters, use warehouse_id abaixo
DATABRICKS_CLUSTER_ID=

# Databricks SQL Warehouse ID (obrigatório para versão free do Databricks)
# Encontrado na URL do warehouse: /sql/warehouses/<warehouse_id>
DATABRICKS_WAREHOUSE_ID=

# Databricks HTTP Path (opcional, para databricks-sql-connector)
# Formato: sql/protocolv1/o/<org_id>/<cluster_id> ou sql/1.0/warehouses/<warehouse_id>
# Se não definido, será construído automaticamente usando warehouse_id
DATABRICKS_HTTP_PATH=

# Catalog e Schema padrão (opcional)
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=default

# Azure Storage (opcional, para acesso ao ADLS Gen2)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCESS_KEY=
AZURE_STORAGE_CONTAINER=
